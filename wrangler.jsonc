{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dream-path",
  "main": "worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Don't auto-canonicalize index.html URLs — the Worker rewrites
    // friendly paths (/, /admin, /about, ...) into actual asset paths
    // and we want to serve them as-is at the original URL.
    "html_handling": "none"
  },

  "kv_namespaces": [
    {
      "binding": "CONTENT_KV",
      "id": "e3cb3043b2694cc7aa990b639a2a982c"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dreampath-db",
      "database_id": "44da55fa-6728-49bf-80ed-125e04454235",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "dreampath-attachments"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Hourly cron: send activation reminders to pending signups + purge
  // accounts whose 72h window expired. Handler: `scheduled()` in worker.js.
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
